# Plantillas de entorno (Sprint 0). Valores reales SOLO en el secrets manager (POL-EGM-08).
# Nunca commitear valores reales. Cada variable documenta: obligatoria/opcional, rotación.

# --- Comunes (todos los entornos: development | qa | staging | production) ---
APP_ENV=development                 # development | qa | staging | production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=donefixer
DB_APP_USER=donefixer_app           # rol de aplicación NO privilegiado (lección Spike: superuser bypassa RLS)
DB_APP_PASSWORD=<secrets-manager>   # rotación ≤90 d (Doc 60)
DB_MIGRATIONS_USER=donefixer_migrator  # rol owner solo para migraciones, nunca usado por la app
DB_MIGRATIONS_PASSWORD=<secrets-manager>

# --- Identidad (WP-B3) ---
JWT_SIGNING_KEY=<secrets-manager>   # rotación ≤90 d
JWT_ISSUER=https://auth.donefixer.example
SESSION_TTL_MINUTES=60

# --- Sync (WP-C2) — PARAMETRIZADO {{ADR-014}}: no configurar hasta ADR-014 definitivo ---
# SYNC_CHANNEL=powersync_cloud | powersync_selfhosted
# POWERSYNC_ENDPOINT=<secrets-manager>
# POWERSYNC_TOKEN=<secrets-manager>     # rotación según ADR-014 definitivo

# --- Observabilidad (Doc 54) ---
OTEL_EXPORTER_ENDPOINT=
LOG_LEVEL=Information

# --- FinOps (Doc 62) ---
COST_CENTER=engineering
AI_BUDGET_ALERT_PCT=30                # línea roja: coste IA >30% revenue tenant (Doc 62/33)

# --- Cloud {{PD-CLOUD}}: parametrizado hasta PD-CLOUD ---
# CLOUD_PROVIDER=
# CLOUD_REGION=
