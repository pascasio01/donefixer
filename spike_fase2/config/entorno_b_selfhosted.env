# Entorno B — PowerSync Self-Hosted (F2). Rellenar en Carril B.
F2_ENV_LABEL=B
PS_MODE=powersync
PS_ENDPOINT=http://<host-docker>:8080
PS_TOKEN=<jwt-generado-con-la-clave-configurada-en-powersync.yaml>
# Metadatos para el Anexo de Reproducibilidad:
F2_PS_IMAGE=ghcr.io/powersync-ja/powersync-service:<tag-exacto>
F2_DOCKER_VERSION=<docker --version>
F2_HOST_HARDWARE=<CPU/RAM/SO del host>
