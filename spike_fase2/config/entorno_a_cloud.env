# Entorno A — PowerSync Cloud (F2). Rellenar en Carril B. NO commitear valores reales en docs públicos.
F2_ENV_LABEL=A
PS_MODE=powersync
PS_ENDPOINT=https://<instance-id>.powersync.journeyapps.com
PS_TOKEN=<jwt-de-desarrollo-generado-en-el-dashboard>
# Metadatos para el Anexo de Reproducibilidad:
F2_PS_SERVICE_VERSION=<versión del servicio mostrada en el dashboard>
F2_PS_REGION=<región seleccionada, p. ej. us-east-1 / eu-west-1>
F2_MEASUREMENT_HOST=<descripción del host de medición>
